#!/usr/bin/env bash
# Encrypt .env into .env.sops.
#
# Refuses to run if .sops.yaml asks for recipients the existing .env.sops does
# not already have. Encrypting secrets must never be the operation that grants
# somebody new access -- that is what secrets-authorize is for.

set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=./secrets-common.sh
. "./scripts/secrets-common.sh"

require_tools
resolve_age_key

[ -f "$ENV_FILE" ] || die "$ENV_FILE not found -- nothing to encrypt"

desired="$(desired_recipients)"
[ -n "$desired" ] || die "no age recipients found in $SOPS_CONFIG"

# SOPS's dotenv parser rejects a line that contains only whitespace, and its
# error does not say which line. Point at it directly.
blank="$(grep -nE '^[[:space:]]+$' "$ENV_FILE" | cut -d: -f1 | tr '\n' ' ' || true)"
[ -z "$blank" ] || die "$ENV_FILE line(s) $blank contain only whitespace; make them empty"

if [ -f "$SOPS_FILE" ]; then
  actual="$(actual_recipients)"
  added="$(comm -13 <(printf '%s\n' "$actual") <(printf '%s\n' "$desired"))"

  if [ -n "$added" ]; then
    cat >&2 <<EOF

ERROR: SOPS recipient authorization changed.

Existing:
$(printf '%s\n' "$actual" | sed 's/^/  /')

Added:
$(printf '%s\n' "$added" | sed 's/^/  + /')

Normal secret encryption cannot grant a new recipient access.

Run:

  make secrets-authorize

to explicitly review the authorization change.

EOF
    exit 1
  fi
fi

# Write to a temporary file and validate it before replacing a known-good one.
tmp="$SOPS_FILE.tmp"
rm -f "$tmp"
trap 'rm -f "$tmp"' EXIT

sops encrypt \
  --filename-override "$SOPS_FILE" \
  --input-type dotenv \
  --output-type dotenv \
  "$ENV_FILE" > "$tmp"

grep -q '^sops_version=' "$tmp" || die "encrypted output carries no SOPS metadata"

echo "Verifying round-trip..."
verify_roundtrip "$tmp" "$ENV_FILE" || die "round-trip verification failed; $SOPS_FILE left unchanged"

mv "$tmp" "$SOPS_FILE"
trap - EXIT
echo "Wrote $SOPS_FILE"
