#!/usr/bin/env bash
# Decrypt .env.sops into a local plaintext .env.
#
# This is what you run after cloning. It overwrites .env, so an existing copy
# is backed up first rather than silently discarded.

set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=./secrets-common.sh
. "./scripts/secrets-common.sh"

require_tools
resolve_age_key

[ -f "$SOPS_FILE" ] || die "$SOPS_FILE not found"

tmp="$ENV_FILE.tmp"
rm -f "$tmp"
trap 'rm -f "$tmp"' EXIT

sops decrypt --input-type dotenv --output-type dotenv "$SOPS_FILE" > "$tmp" \
  || die "decryption failed -- is an authorized age identity available?"

if [ -f "$ENV_FILE" ] && ! cmp -s "$tmp" "$ENV_FILE"; then
  cp "$ENV_FILE" "$ENV_FILE.bak"
  echo "Existing $ENV_FILE differed; previous copy saved as $ENV_FILE.bak"
fi

mv "$tmp" "$ENV_FILE"
trap - EXIT
chmod 600 "$ENV_FILE"
echo "Wrote $ENV_FILE ($(grep -cE '^[A-Za-z_][A-Za-z0-9_]*=' "$ENV_FILE") variables)"
