#!/usr/bin/env bash
# Check the agent sandbox on this host, end to end (docs/sandbox.md).
#
#   scripts/sandbox-smoke            conformance + runner probes (fake claude)
#   scripts/sandbox-smoke --real     also one task with the real claude CLI
#                                    (billed; needs CLAUDE_CODE_OAUTH_TOKEN in
#                                    the env or in .env, from `claude setup-token`)
#
# 1. Conformance: what agentbox actually enforces on this host (gVisor on
#    Linux, Seatbelt on macOS), gated on
#    .github/sandbox-baselines/agentbox-<backend>.json.
# 2. Runner probes: the real agent-runner, with a fake `claude` that tries to
#    escape (read ~/.ssh and the runner's .env, write outside the workspace,
#    reach the network, ...) and checks it reaches the model only through the
#    per-run proxy. Every outcome is checked against what the sandbox should
#    allow, under the default policy and with egress "none".
#
# Env:
#   KEEP=1       keep the work dir (runner logs, probe reports)
#   SMOKE_PORT   runner port (default 18093)
#   AGENT_RUNNER_BIN, CONFORMANCE_BIN   prebuilt binaries (scripts/sandbox-agentbox)
#   AGENTBOX_EGRESS  egress mode required of this host: transparent (the
#                default on Linux: every connection reaches the gateway; needs
#                ip, nft and agentbox-unshare where AppArmor restricts user
#                namespaces) or proxy (the only one on macOS)
#
# The probes record outcomes and byte counts only, never file contents.

set -euo pipefail
cd "$(dirname "$0")/.."
REPO=$PWD

REAL=0
[ "${1:-}" = "--real" ] && REAL=1
PORT=${SMOKE_PORT:-18093}

# agentbox's backend for this OS. scripts/sandbox-agentbox runs the Linux
# one in Docker from any host.
case "$(uname -s)" in
Darwin) BACKEND=seatbelt AGENTBOX_EGRESS=${AGENTBOX_EGRESS:-proxy} ;;
Linux) BACKEND=gvisor AGENTBOX_EGRESS=${AGENTBOX_EGRESS:-transparent} ;;
*) echo "unsupported OS: $(uname -s)" >&2; exit 2 ;;
esac
if [ "$(id -u)" = 0 ]; then
	echo "agentbox runs as a normal user, as agent-runner does: not as root" >&2
	exit 2
fi
# GV: the checks only gVisor can pass (limits: fork bombs).
GV=0; [ "$BACKEND" = gvisor ] && GV=1
EGRESS_MODE=$AGENTBOX_EGRESS

W=$(mktemp -d "${TMPDIR:-/tmp}/sandbox-smoke.XXXXXX")
W=$(cd "$W" && pwd -P)
RUNNER_PID=
SAMPLER=
cleanup() {
	[ -n "$RUNNER_PID" ] && kill "$RUNNER_PID" 2>/dev/null && wait "$RUNNER_PID" 2>/dev/null
	[ -n "$SAMPLER" ] && kill "$SAMPLER" 2>/dev/null
	pkill -f "sleep 9997" 2>/dev/null || true
	rm -rf "$OTHER"
	if [ "${KEEP:-}" = 1 ]; then echo "kept $W"; else rm -rf "$W"; fi
}
trap cleanup EXIT

# Another project in the host user's home: scoped reads must hide it.
OTHER=$HOME/.sandbox-smoke-other-project.$$
mkdir -p "$OTHER" && echo "OTHER-PROJECT-MARKER" >"$OTHER/notes.txt"

FAILED=0
pass() { printf '  ok    %s\n' "$*"; }
fail() { printf '  FAIL  %s\n' "$*"; FAILED=1; }
step() { printf '\n== %s\n' "$*"; }

# --- binaries ----------------------------------------------------------------

step "build"
AGENT_RUNNER_BIN=${AGENT_RUNNER_BIN:-$W/agent-runner}
CONFORMANCE_BIN=${CONFORMANCE_BIN:-$W/sandbox-conformance}
[ -x "$AGENT_RUNNER_BIN" ] || go build -o "$AGENT_RUNNER_BIN" ./cmd/server
[ -x "$CONFORMANCE_BIN" ] || go build -o "$CONFORMANCE_BIN" ./cmd/sandbox-conformance
[ "$BACKEND" = gvisor ] && echo "agentbox: gVisor, $(runsc --version 2>/dev/null | head -1)" || echo "agentbox: Seatbelt"

# --- 1. conformance ------------------------------------------------------------

step "conformance ($BACKEND)"
if (cd "$W" && "$CONFORMANCE_BIN" --report "report-$BACKEND.json" --manifest "manifest-$BACKEND.json" \
	--require-file "$REPO/.github/sandbox-baselines/agentbox-$BACKEND.json" 2>&1 | grep -v notrun); then
	pass "baseline capabilities proven"
else
	fail "baseline capabilities not proven (see above)"
fi

# --- 2. runner probes ----------------------------------------------------------

RUN=$W/run   # the runner's working dir: its .env lives here
DATA=$RUN/data
mkdir -p "$W/bin" "$RUN"
echo "FAKE_RUNNER_SECRET=1" >"$RUN/.env"

# The fake claude. Paths are baked in: the sandbox passes no host env through.
# The host's own private address: egress through a gateway must not reach it.
HOSTIP=$( (hostname -I 2>/dev/null || ipconfig getifaddr en0 2>/dev/null) | awk '{print $1}')
cat >"$W/bin/claude" <<EOF
#!/bin/bash
# The fork-bomb check: fork forever while the main process stays alive (when
# it exits, gVisor kills every process left in the sandbox).
case "\$*" in *"sandbox fork bomb"*)
	# Proof the bomb ran: a sandbox that never started also "ends early".
	mkdir -p "\$PWD/_send" && echo started >"\$PWD/_send/bomb-started"
	b() { b | b & }
	b
	exec sleep 600 ;;
esac
# The pids-cap check: report done first, then fork forever for 10s. Under the
# cap fork() fails (EAGAIN, logged to _send/bomb.txt) and the run ends normally.
case "\$*" in *"sandbox pids bomb"*)
	mkdir -p "\$PWD/_send"
	exec 2>"\$PWD/_send/bomb.txt"
	echo '{"result":"TASK: DONE","cost_usd":0,"duration_ms":1}'
	b() { b | b & }
	b
	exec sleep 10 ;;
esac
R="\$PWD/_send/report.txt"; mkdir -p "\$PWD/_send"
# try: allowed when the command succeeds (writes, network).
try() {
	local name="\$1"; shift
	if out=\$("\$@" 2>&1); then echo "allowed|\$name|\$(printf %s "\$out" | wc -c | tr -d ' ') bytes"
	else echo "blocked|\$name|\$(printf %s "\$out" | tail -c 80 | tr '\n' ' ')"; fi
}
# tryhttp: allowed when an http:// URL answers with anything but the egress
# gateway's own refusal (curl exits 0 on any HTTP answer, the gateway's 403
# included).
tryhttp() {
	local name="\$1"; shift
	local code
	code=\$(curl -s -m 5 -o "\$PWD/.tryhttp" -w '%{http_code}' "\$@" 2>/dev/null)
	if [ "\$code" != 000 ] && ! grep -q 'egress Forbidden' "\$PWD/.tryhttp" 2>/dev/null; then echo "allowed|\$name|HTTP \$code"
	else echo "blocked|\$name|HTTP \$code"; fi
	rm -f "\$PWD/.tryhttp"
}
# tryread: allowed only when the read returns something. gVisor hides a
# denied path behind an empty one rather than failing the read, so every
# target is non-empty on the host.
tryread() {
	local name="\$1"; shift
	if out=\$("\$@" 2>&1) && [ -n "\$out" ]; then echo "allowed|\$name|\$(printf %s "\$out" | wc -c | tr -d ' ') bytes"
	else echo "blocked|\$name|\$(printf %s "\$out" | tail -c 80 | tr '\n' ' ')"; fi
}
{
	echo "env|home|\$HOME"
	echo "env|config_dir|\$CLAUDE_CONFIG_DIR"
	echo "env|codex_home|\$CODEX_HOME"
	echo "env|pi_dir|\$PI_CODING_AGENT_DIR"
	echo "env|token|\${CLAUDE_CODE_OAUTH_TOKEN:+present}"
	echo "env|proxy_url|\${ANTHROPIC_BASE_URL:+present}"
	echo "env|proxy_token|\${ANTHROPIC_AUTH_TOKEN:+present}"
	# The model proxy answers (any HTTP status: the smoke's credential is fake).
	if [ -n "\$ANTHROPIC_BASE_URL" ]; then
		code=\$(curl -sS -m 10 -o /dev/null -w "%{http_code}" -I -H "Authorization: Bearer \$ANTHROPIC_AUTH_TOKEN" "\$ANTHROPIC_BASE_URL/api/hello" 2>&1)
		case \$code in [1-5]??) echo "allowed|model_proxy|HTTP \$code" ;; *) echo "blocked|model_proxy|\$code" ;; esac
	fi
	echo "env|host_secret|\${FAKE_SECRET_TOKEN:+present}"
	echo "env|egress_proxy|\${HTTPS_PROXY:+present}"
	tryread ssh_dir ls $HOME/.ssh
	tryread aws_dir ls $HOME/.aws
	tryread claude_dir ls $HOME/.claude
	tryread runner_env cat $RUN/.env
	tryread runner_env_local cat $DATA/.env.local
	tryread runner_logs ls $DATA/logs
	tryread other_session ls $DATA/tmp/session-other
	tryread journal ls $DATA/state/sessions
	tryread memory ls $DATA/memory
	tryread host_home  ls -a $HOME
	tryread other_project cat $OTHER/notes.txt
	tryread etc_shadow cat /etc/shadow
	tryread etc_config cat /etc/os-release
	try tool_git       git --version
	try tool_python    python3 -c "print(1)"
	try write_outside  sh -c "echo x > $W/escaped"
	try write_tmp      sh -c "echo x > /tmp/sandbox-smoke-escaped"
	try write_workspace sh -c "echo x > \$PWD/inside.txt"
	try write_config   sh -c "echo x > \$CLAUDE_CONFIG_DIR/probe && echo x > \$CODEX_HOME/probe && echo x > \$PI_CODING_AGENT_DIR/probe"
	tryread pi_auth    cat $HOME/.pi/agent/auth.json
	ln -sf $W/run/.env link 2>/dev/null
	tryread symlink cat link
	tryhttp metadata_ip http://169.254.169.254/
	try internet       curl -sS -m 5 -o /dev/null https://example.com
	try git_https      git ls-remote https://github.com/tendant/agentbox.git HEAD
	try egress_bypass  curl -sS -m 5 -o /dev/null --noproxy '*' https://example.com
	tryhttp private_net --proxy "\${HTTPS_PROXY:-}" http://$HOSTIP:$PORT/health
	tryhttp private_direct --noproxy '*' http://$HOSTIP:$PORT/health
	tryhttp metadata_direct --noproxy '*' http://169.254.169.254/
	nohup sleep 9997 >/dev/null 2>&1 &
} >"\$R" 2>&1
echo '{"result":"TASK: DONE","cost_usd":0,"duration_ms":1}'
EOF
chmod +x "$W/bin/claude"

# start_runner MODE [ENV=VALUE...]: a runner on $PORT with a fresh data dir.
start_runner() {
	local mode=$1; shift
	rm -rf "$DATA"
	# Non-empty, so a read the sandbox hides (empty) differs from one it allows.
	for d in tmp/session-other logs state/sessions memory; do
		mkdir -p "$DATA/$d" && echo marker >"$DATA/$d/marker"
	done
	echo "SECRET=1" >"$DATA/.env.local"
	(cd "$RUN" && exec env -i PATH="$PATH_FOR_RUNNER" HOME="$HOME" \
		DATA_DIR="$DATA" API_BIND="127.0.0.1:$PORT" AGENT_CLI=claude \
		AGENT_PLANNER_ENABLED=false AGENT_REVIEWER_ENABLED=false AGENT_MEMORY_CURATION_ENABLED=false \
		AGENT_MAX_ITERATIONS=1 AGENT_SANDBOX="$mode" \
		AGENT_SANDBOX_EGRESS_MODE="$EGRESS_MODE" FAKE_SECRET_TOKEN=leak-me "$@" "$AGENT_RUNNER_BIN" >"$W/runner-$mode.log" 2>&1) &
	RUNNER_PID=$!
	for _ in $(seq 100); do curl -sf "localhost:$PORT/health" >/dev/null && return 0; sleep 0.1; done
	echo "runner did not start; log:" >&2; tail -20 "$W/runner-$mode.log" >&2; exit 1
}
stop_runner() { kill "$RUNNER_PID" 2>/dev/null; wait "$RUNNER_PID" 2>/dev/null || true; RUNNER_PID=; }

# run_task MESSAGE [TIMEOUT]: post a task and wait. Sets SESSION, LAST_BODY
# and RESULT ("status|error").
run_task() {
	local id status body
	id=$(curl -s -XPOST "localhost:$PORT/agent" -H 'Content-Type: application/json' \
		-d "{\"message\":$(printf '%s' "$1" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')}" |
		python3 -c 'import json,sys;print(json.load(sys.stdin)["session_id"])')
	for _ in $(seq "${2:-60}"); do
		body=$(curl -s "localhost:$PORT/agent/$id")
		status=$(printf '%s' "$body" | python3 -c 'import json,sys;print(json.load(sys.stdin)["status"])')
		case $status in completed | failed | stopped) break ;; esac
		sleep 1
	done
	SESSION=$id
	LAST_BODY=$body
	RESULT="$status|$(printf '%s' "$body" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("error",""))')"
}

# expect NAME allowed|blocked: check one probe outcome in $REPORT.
expect() {
	local line got
	line=$(grep "^[a-z]*|$1|" "$REPORT" || true)
	got=${line%%|*}
	if [ -z "$line" ]; then fail "$1: no result"
	elif [ "$got" = "$2" ]; then pass "$1 $got"
	else fail "$1 $got, want $2 (${line##*|})"; fi
}
expect_env() {
	local v
	v=$(grep "^env|$1|" "$REPORT" | cut -d'|' -f3-)
	case $v in $2) pass "$1 = ${v:-<unset>}" ;; *) fail "$1 = ${v:-<unset>}, want $2" ;; esac
}

PATH_FOR_RUNNER="$W/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# probe MODE [ENV...]: run the fake claude once and load its report.
probe() {
	start_runner "$@"
	run_task "sandbox smoke probe"
	REPORT=$(find "$DATA" -path "*$SESSION*" -name report.txt | head -1)
	stop_runner
	if [ -z "$REPORT" ]; then
		fail "no probe report (session: $RESULT)"
		# The last iteration's own error/output says why.
		printf '%s' "$LAST_BODY" | python3 -c 'import json,sys
d=json.load(sys.stdin); it=(d.get("iterations") or [{}])[-1]
print("        iteration:", ((it.get("error") or "") + " " + (it.get("output") or ""))[-600:].replace("\n"," | "))' 2>/dev/null || true
		return 1
	fi
	pass "session ${RESULT%%|*}"
}

step "runner, default policy (permissive)"
rm -f /tmp/sandbox-smoke-escaped
if probe permissive CLAUDE_CODE_OAUTH_TOKEN=smoke-fake-token; then
	# Only where the host has something there to hide.
	[ -n "$(ls -A "$HOME/.ssh" 2>/dev/null)" ] && expect ssh_dir blocked
	[ -n "$(ls -A "$HOME/.aws" 2>/dev/null)" ] && expect aws_dir blocked
	[ -n "$(ls -A "$HOME/.claude" 2>/dev/null)" ] && expect claude_dir blocked
	for n in runner_env runner_env_local runner_logs other_session journal \
		write_outside symlink metadata_ip; do
		expect $n blocked
	done
	# gVisor gives the sandbox a private /tmp (the write succeeds there),
	# Seatbelt refuses it: either way the host's /tmp must not change.
	if [ -e /tmp/sandbox-smoke-escaped ]; then fail "write_tmp reached the host's /tmp"
	elif grep -q '^allowed|write_tmp|' "$REPORT"; then pass "write_tmp stayed in the sandbox's own /tmp"
	else expect write_tmp blocked; fi
	for n in memory write_workspace write_config; do expect $n allowed; done
	# No direct network: egress only through the run's gateway, the model
	# through its proxy (model_proxy below). git over HTTPS works; the host's
	# private address and metadata are refused, proxy settings honoured or
	# not. Transparent: a program ignoring them still gets public hosts,
	# through the gateway; proxy: it gets nothing.
	expect internet allowed
	expect git_https allowed
	[ -n "$HOSTIP" ] && expect private_net blocked
	[ -n "$HOSTIP" ] && expect private_direct blocked
	expect metadata_direct blocked
	# The gateway's decisions reach the session's audit log.
	AUDIT=$(ls "$DATA"/logs/*_agent_"$SESSION".md 2>/dev/null | head -1)
	if [ -n "$AUDIT" ] && grep -q '^## Network' "$AUDIT" && grep -q '^| `169.254.169.254` | 0 | [1-9]' "$AUDIT" &&
		grep -q '^| `github.com` | [1-9]' "$AUDIT"; then pass "audit log lists the refused metadata address and allowed github.com"
	else fail "no Network section with the gateway's decisions in ${AUDIT:-the audit log}"; fi
	if [ "$AGENTBOX_EGRESS" = transparent ]; then
		expect egress_bypass allowed
		expect_env egress_proxy ""
	else
		expect egress_bypass blocked
		expect_env egress_proxy present
	fi
	[ -e /etc/shadow ] && expect etc_shadow blocked
	# What scoped reads hide, and what they must not break.
	for n in host_home other_project; do expect $n blocked; done
	[ -e /etc/os-release ] && expect etc_config allowed
	command -v git >/dev/null && expect tool_git allowed
	expect tool_python allowed
	expect_env home "$DATA/state/sandbox/home/*"
	expect_env config_dir "$DATA/state/sandbox/home/*/.claude"
	expect_env codex_home "$DATA/state/sandbox/home/*/.codex"
	expect_env pi_dir "$DATA/state/sandbox/home/*/.pi/agent"
	[ -s "$HOME/.pi/agent/auth.json" ] && expect pi_auth blocked
	# The model proxy holds the token; claude gets its URL and a run token.
	expect_env token ""
	expect_env proxy_url present
	expect_env proxy_token present
	expect model_proxy allowed
	expect_env host_secret ""
	[ ! -e "$W/escaped" ] || fail "a file was written outside the workspace"
	leftover=$(find "$DATA/state/sandbox/leases" -type f ! -name .lock 2>/dev/null | wc -l | tr -d ' ')
	[ "$leftover" = 0 ] && pass "no lease files left" || fail "$leftover lease files left"
fi

# Linux: the other egress mode, the gateway's proxy path.
if [ "$AGENTBOX_EGRESS" = transparent ]; then
	step "runner, egress through HTTPS_PROXY only"
	if probe permissive CLAUDE_CODE_OAUTH_TOKEN=smoke-fake-token AGENT_SANDBOX_EGRESS_MODE=proxy; then
		expect internet allowed
		expect egress_bypass blocked
		expect metadata_direct blocked
		expect_env egress_proxy present
	fi
fi

step "runner, egress none"
if probe permissive CLAUDE_CODE_OAUTH_TOKEN=smoke-fake-token \
	AGENT_SANDBOX_POLICY='{"version":1,"network":{"egress":"none"}}'; then
	expect internet blocked
	expect metadata_ip blocked
	expect egress_bypass blocked
	expect write_workspace allowed # unset grants inherit the default policy
	# The model channel needs no network: claude still gets the proxy.
	expect_env proxy_url present
	expect_env token ""
	expect model_proxy allowed
fi

# Strict: every capability the policy needs, proven by the conformance run.
step "runner, strict (evidence from the conformance run)"
if probe strict CLAUDE_CODE_OAUTH_TOKEN=smoke-fake-token AGENT_SANDBOX_EVIDENCE="$W/report-$BACKEND.json"; then
	expect runner_env blocked
	expect write_outside blocked
	expect write_workspace allowed
fi

if [ "$GV" = 1 ]; then
	# Two fork bombs: under the memory cap (a systemd user scope) the sandbox
	# is killed; under the pids cap (RLIMIT_NPROC inside gVisor) fork() fails
	# and the run finishes. macOS has neither cap.
	mem_avail() { awk '/^MemAvailable:/ { print $2 * 1024 }' /proc/meminfo; }
	# bomb MESSAGE ENV...: run one task with host memory sampled. Sets RESULT,
	# ELAPSED and DROP (the largest fall in host available memory).
	bomb() {
		local msg=$1 before
		shift
		before=$(mem_avail)
		echo "$before" >"$W/mem-low"
		(
			low=$before
			while :; do
				m=$(mem_avail)
				[ "$m" -lt "$low" ] && low=$m && echo "$low" >"$W/mem-low"
				sleep 0.5
			done
		) &
		SAMPLER=$!
		RUNSC_BEFORE=$(pgrep -c runsc || true)
		start_runner permissive CLAUDE_CODE_OAUTH_TOKEN=smoke-fake-token AGENT_MAX_ITERATION_SECONDS=120 "$@"
		local t0=$SECONDS
		run_task "$msg" 150
		ELAPSED=$((SECONDS - t0))
		if curl -sf "localhost:$PORT/health" >/dev/null; then pass "runner alive"; else fail "runner not answering after the fork bomb"; fi
		stop_runner
		kill "$SAMPLER" 2>/dev/null; wait "$SAMPLER" 2>/dev/null || true; SAMPLER=
		DROP=$((before - $(cat "$W/mem-low")))
	}
	bomb_cleanup() {
		if [ "$DROP" -lt $((1536 << 20)) ]; then pass "host available memory fell by $((DROP >> 20)) MiB at most"
		else fail "host available memory fell by $((DROP >> 20)) MiB"; fi
		for _ in $(seq 20); do [ "$(pgrep -c runsc || true)" -le "$RUNSC_BEFORE" ] && break; sleep 0.5; done
		local left=$(($(pgrep -c runsc || true) - RUNSC_BEFORE)) leftover
		[ "$left" -le 0 ] && pass "no runsc processes left" || fail "$left runsc processes left"
		leftover=$(find "$DATA/state/sandbox/leases" -type f ! -name .lock 2>/dev/null | wc -l | tr -d ' ')
		[ "$leftover" = 0 ] && pass "no lease files left" || fail "$leftover lease files left"
	}

	step "runner, fork bomb under AGENT_SANDBOX_MEMORY=512m"
	if ! systemd-run --user --scope --quiet true 2>/dev/null; then
		# agentbox caps memory through a systemd user scope and refuses a
		# memory limit without one (checked by its own tests).
		echo "  skip  no systemd user scope here"
	else
	bomb "sandbox fork bomb" AGENT_SANDBOX_MEMORY=512m
	# Well before the 120s iteration timeout: the memory cap ended it.
	case $RESULT in
	*"sandbox rejected run"*) fail "the sandbox never started: ${RESULT#*|}" ;;
	completed* | failed* | stopped*)
		if [ -z "$(find "$DATA" -path "*$SESSION*" -name bomb-started | head -1)" ]; then
			fail "the fork bomb never ran (${RESULT%%|*}: ${RESULT#*|})"
		elif [ "$ELAPSED" -lt 90 ]; then pass "sandbox killed after ${ELAPSED}s (${RESULT%%|*}: ${RESULT#*|})"
		else fail "the fork bomb ran ${ELAPSED}s: ended by the timeout, not the memory cap"; fi ;;
	*) fail "session still ${RESULT%%|*} after ${ELAPSED}s" ;;
	esac
	bomb_cleanup
	fi

	step "runner, fork bomb under AGENT_SANDBOX_PIDS=256 (no memory cap)"
	bomb "sandbox pids bomb" AGENT_SANDBOX_PIDS=256
	# Completed, and inside the 120s iteration timeout (which would fail it).
	# Tearing the bomb's processes down inside gVisor takes a while: 30-60s
	# on a workstation, over 90s on a 2-core CI runner.
	if [ "${RESULT%%|*}" = completed ] && [ "$ELAPSED" -lt 120 ]; then pass "session completed after ${ELAPSED}s"
	else fail "session ${RESULT} after ${ELAPSED}s, want completed"; fi
	BOMB=$(find "$DATA" -path "*$SESSION*" -name bomb.txt | head -1)
	if [ -n "$BOMB" ] && grep -q "Resource temporarily unavailable" "$BOMB"; then pass "fork() failed with EAGAIN"
	else fail "no EAGAIN from fork() (${BOMB:-no bomb.txt})"; fi
	bomb_cleanup
fi

# The sandbox runs as the runner's own user, so a private (0700) home is no
# obstacle.
step "runner, data dir under a private home"
PRIV=$W/private
install -d -m 0700 "$PRIV"
DATA_SAVED=$DATA DATA=$PRIV/data
start_runner permissive CLAUDE_CODE_OAUTH_TOKEN=smoke-fake-token
run_task "sandbox smoke probe" 60
stop_runner
DATA=$DATA_SAVED
if [ "${RESULT%%|*}" = completed ]; then pass "runs under a 0700 home owned by the runner"
else fail "under a 0700 home: $RESULT"; fi

# The real codex CLI on a ChatGPT login, through the model proxy, against
# a fake ChatGPT backend: codex must start under scoped reads (node and
# its npm install under the home), reach the proxy, and the proxy must
# attach the login's token and account id.
step "runner, codex on a ChatGPT login (fake backend)"
CODEX_BIN=$(command -v codex || true)
if [ -z "$CODEX_BIN" ]; then
	echo "  skip  codex not installed"
else
	cat >"$W/fake-chatgpt.py" <<'PY'
import http.server, json, sys
log, portfile = sys.argv[1], sys.argv[2]
class H(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0); self.rfile.read(n)
        with open(log, "a") as f:
            f.write("%s|%s|%s\n" % (self.path, self.headers.get("Authorization"), self.headers.get("ChatGPT-Account-ID")))
        if not self.path.endswith("/responses"):
            self.send_response(404); self.end_headers(); return
        self.send_response(200); self.send_header("Content-Type", "text/event-stream"); self.end_headers()
        for ev in ({"type": "response.created", "response": {"id": "r1"}},
                   {"type": "response.output_item.done", "item": {"type": "message", "role": "assistant", "id": "m1",
                    "content": [{"type": "output_text", "text": "PONG-FROM-FAKE-CHATGPT. TASK: DONE"}]}},
                   {"type": "response.completed", "response": {"id": "r1", "usage": {"input_tokens": 1, "input_tokens_details": None,
                    "output_tokens": 1, "output_tokens_details": None, "total_tokens": 2}}}):
            self.wfile.write(("event: %s\ndata: %s\n\n" % (ev["type"], json.dumps(ev))).encode())
    do_GET = do_POST
    def log_message(self, *a): pass
srv = http.server.HTTPServer(("127.0.0.1", 0), H)
open(portfile, "w").write(str(srv.server_port))
srv.serve_forever()
PY
	python3 "$W/fake-chatgpt.py" "$W/chatgpt.log" "$W/chatgpt.port" &
	FAKE_CHATGPT=$!
	for _ in $(seq 50); do [ -s "$W/chatgpt.port" ] && break; sleep 0.1; done
	mkdir -p "$W/codex-login"
	ACCESS=$(python3 -c 'import base64,json,time;e=lambda d:base64.urlsafe_b64encode(json.dumps(d).encode()).decode().rstrip("=");print(e({"alg":"none"})+"."+e({"exp":int(time.time())+86400})+".sig")')
	printf '{"auth_mode":"chatgpt","tokens":{"access_token":"%s","refresh_token":"smoke-refresh","id_token":"%s","account_id":"acct-smoke"},"last_refresh":"2026-01-01T00:00:00Z"}\n' "$ACCESS" "$ACCESS" >"$W/codex-login/auth.json"
	SAVED_PATH=$PATH_FOR_RUNNER
	PATH_FOR_RUNNER="$(dirname "$CODEX_BIN"):$(dirname "$(command -v node)"):$PATH_FOR_RUNNER"
	start_runner permissive AGENT_CLI=codex AGENT_SANDBOX_CODEX_LOGIN="$W/codex-login/auth.json" \
		AGENT_SANDBOX_CHATGPT_URL="http://127.0.0.1:$(cat "$W/chatgpt.port")"
	run_task "say pong" 180
	stop_runner
	PATH_FOR_RUNNER=$SAVED_PATH
	kill "$FAKE_CHATGPT" 2>/dev/null
	if [ "${RESULT%%|*}" = completed ]; then pass "session completed"; else fail "session: $RESULT"; fi
	if grep -q "^/backend-api/codex/responses|Bearer $ACCESS|acct-smoke$" "$W/chatgpt.log" 2>/dev/null; then
		pass "backend got /backend-api/codex/responses with the login's token and account id"
	else
		fail "backend requests: $(cut -d'|' -f1,3 "$W/chatgpt.log" 2>/dev/null | sort -u | tr '\n' ' ')"
	fi
	case $LAST_BODY in *PONG-FROM-FAKE-CHATGPT*) pass "codex returned the backend's reply" ;; *) fail "no reply from codex in the session" ;; esac
	if grep -rqs "smoke-refresh" "$DATA/tmp" "$DATA/state/sandbox"; then fail "the login's refresh token is in the run's files"
	else pass "the login's refresh token is not in the run's files"; fi
fi

step "runner, the real claude CLI (fake Anthropic backend)"
# Free: the CLI itself, sandboxed, through the model proxy to a stand-in
# for the API. Catches the CLI refusing to start in the sandbox (as uid 0
# under gVisor) or not reaching the model through the proxy.
REAL_CLAUDE=$(command -v claude || true)
if [ -z "$REAL_CLAUDE" ] || [ "$(dirname "$REAL_CLAUDE")" = "$W/bin" ]; then
	echo "  skip  the claude CLI is not installed (npm i -g @anthropic-ai/claude-code)"
else
	cat >"$W/fake-anthropic.py" <<'PY'
import http.server, json, sys
log, portfile = sys.argv[1], sys.argv[2]
TEXT = "PONG-FROM-FAKE-ANTHROPIC. TASK: DONE"
class H(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        n = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(n)
        with open(log, "a") as f:
            f.write("%s|%s\n" % (self.path, self.headers.get("x-api-key")))
        if not self.path.split("?")[0].endswith("/v1/messages"):
            self.send_response(200); self.send_header("Content-Type", "application/json"); self.end_headers()
            self.wfile.write(b"{}"); return
        try: stream = json.loads(body or b"{}").get("stream")
        except Exception: stream = False
        msg = {"id": "msg_smoke", "type": "message", "role": "assistant", "model": "claude-smoke",
               "content": [], "stop_reason": None, "stop_sequence": None, "usage": {"input_tokens": 1, "output_tokens": 1}}
        if not stream:
            msg.update(content=[{"type": "text", "text": TEXT}], stop_reason="end_turn")
            self.send_response(200); self.send_header("Content-Type", "application/json"); self.end_headers()
            self.wfile.write(json.dumps(msg).encode()); return
        self.send_response(200); self.send_header("Content-Type", "text/event-stream"); self.end_headers()
        for ev in ({"type": "message_start", "message": msg},
                   {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}},
                   {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": TEXT}},
                   {"type": "content_block_stop", "index": 0},
                   {"type": "message_delta", "delta": {"stop_reason": "end_turn", "stop_sequence": None}, "usage": {"output_tokens": 5}},
                   {"type": "message_stop"}):
            self.wfile.write(("event: %s\ndata: %s\n\n" % (ev["type"], json.dumps(ev))).encode())
    def do_GET(self):
        self.send_response(200); self.send_header("Content-Type", "application/json"); self.end_headers(); self.wfile.write(b"{}")
    def log_message(self, *a): pass
srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)
open(portfile, "w").write(str(srv.server_port))
srv.serve_forever()
PY
	python3 "$W/fake-anthropic.py" "$W/anthropic.log" "$W/anthropic.port" &
	FAKE_ANTHROPIC=$!
	for _ in $(seq 50); do [ -s "$W/anthropic.port" ] && break; sleep 0.1; done
	SAVED_PATH=$PATH_FOR_RUNNER
	PATH_FOR_RUNNER="$(dirname "$REAL_CLAUDE"):$(dirname "$(command -v node)"):/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
	start_runner permissive ANTHROPIC_API_KEY=smoke-fake-key ANTHROPIC_BASE_URL="http://127.0.0.1:$(cat "$W/anthropic.port")"
	run_task "say pong" 180
	stop_runner
	PATH_FOR_RUNNER=$SAVED_PATH
	kill "$FAKE_ANTHROPIC" 2>/dev/null
	if [ "${RESULT%%|*}" = completed ]; then pass "session completed"; else fail "session: $RESULT"; fi
	case $LAST_BODY in *"cannot be used with root"*) fail "claude refused to run as root in the sandbox" ;; esac
	if grep -q "/v1/messages.*|smoke-fake-key$" "$W/anthropic.log" 2>/dev/null; then
		pass "the API got /v1/messages with the runner's key, through the proxy"
	else
		fail "API requests: $(sort -u "$W/anthropic.log" 2>/dev/null | cut -d'|' -f1 | tr '\n' ' ')"
	fi
	case $LAST_BODY in *PONG-FROM-FAKE-ANTHROPIC*) pass "claude returned the API's reply" ;; *) fail "no reply from claude in the session" ;; esac
fi

step "runner, no claude credentials"
start_runner permissive
run_task "sandbox smoke probe" 20
stop_runner
case $RESULT in
"failed|"*"claude setup-token"*) pass "fails before starting, pointing at claude setup-token" ;;
*) fail "want a failed session naming claude setup-token, got: $RESULT" ;;
esac

# --- 3. the real claude CLI (--real) -----------------------------------------------

if [ "$REAL" = 1 ]; then
	step "real claude (billed)"
	TOKEN=${CLAUDE_CODE_OAUTH_TOKEN:-$(sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' .env 2>/dev/null | tr -d '"'"'" | head -1)}
	REAL_CLAUDE=$(command -v claude || true)
	if [ -z "$TOKEN" ] || [ -z "$REAL_CLAUDE" ]; then
		fail "needs the claude CLI and CLAUDE_CODE_OAUTH_TOKEN (claude setup-token)"
	else
		PATH_FOR_RUNNER="$(dirname "$REAL_CLAUDE"):/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
		start_runner permissive CLAUDE_CODE_OAUTH_TOKEN="$TOKEN"
		run_task "Create hello.txt containing the word sandboxed. Then run 'ls ~/.ssh' with the Bash tool and report its output verbatim. Then say TASK: DONE." 300
		stop_runner
		if [ "${RESULT%%|*}" = completed ]; then pass "session completed"; else fail "session: $RESULT"; fi
		printf '%s' "$LAST_BODY" | python3 -c '
import json,sys
d=json.load(sys.stdin)
print("  cost: $%.4f" % (d.get("total_cost_usd") or 0))
for it in d.get("iterations") or []:
    print("  reply:", (it.get("output") or it.get("error") or "")[:800].replace("\n","\n         "))'
	fi
fi

step "result"
if [ "$FAILED" = 0 ]; then echo "all checks passed"; else echo "some checks FAILED"; fi
exit "$FAILED"
