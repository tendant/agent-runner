#!/usr/bin/env bash
# Change who can decrypt .env.sops, to match the recipients in .sops.yaml.
#
# This is the only operation allowed to expand access, and it is interactive on
# purpose: a noninteractive process should not be able to approve a new
# recipient on its own.

set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=./secrets-common.sh
. "./scripts/secrets-common.sh"

require_tools
resolve_age_key

[ -f "$SOPS_FILE" ] || die "$SOPS_FILE not found -- run 'make secrets-encrypt' first"

desired="$(desired_recipients)"
actual="$(actual_recipients)"

added="$(comm -13 <(printf '%s\n' "$actual") <(printf '%s\n' "$desired"))"
removed="$(comm -23 <(printf '%s\n' "$actual") <(printf '%s\n' "$desired"))"

if [ -z "$added" ] && [ -z "$removed" ]; then
  echo "Recipients already match $SOPS_CONFIG; nothing to authorize."
  exit 0
fi

echo
echo "SOPS authorization change"
echo
[ -n "$added" ]   && printf '%s\n' "$added"   | sed 's/^/  + /'
[ -n "$removed" ] && printf '%s\n' "$removed" | sed 's/^/  - /'
echo

if [ -n "$added" ]; then
  cat <<EOF
Adding a recipient gives the holder of its private
key access to every encrypted secret in $SOPS_FILE.
EOF
fi

if [ -n "$removed" ]; then
  cat <<EOF
Removing a recipient only controls future access. It
cannot un-read secrets they already decrypted -- rotate
the underlying credentials as well.
EOF
fi

echo
printf 'Type "yes" to authorize: '
read -r reply
[ "$reply" = "yes" ] || die "aborted; $SOPS_FILE unchanged"

cp "$SOPS_FILE" "$SOPS_FILE.bak"
# updatekeys cannot infer the format from a .env.sops name, so state it.
if sops updatekeys --yes --input-type dotenv "$SOPS_FILE"; then
  rm -f "$SOPS_FILE.bak"
  echo
  echo "Authorized. Commit $SOPS_CONFIG and $SOPS_FILE together."
else
  mv "$SOPS_FILE.bak" "$SOPS_FILE"
  die "updatekeys failed; $SOPS_FILE restored"
fi
