#!/usr/bin/env bash
# Read-only policy check. Safe to run anywhere, including CI.
#
# Verifies that .env.sops is a valid SOPS dotenv file, that the recipients it
# actually carries match the ones .sops.yaml asks for, and that no obviously
# sensitive variable was left unencrypted.

set -euo pipefail
cd "$(dirname "$0")/.."
# shellcheck source=./secrets-common.sh
. "./scripts/secrets-common.sh"

require_tools

fail=0
note() { printf '%s %s\n' "$1" "$2"; }
ok()   { note "OK  " "$1"; }
bad()  { note "FAIL" "$1"; fail=1; }

[ -f "$SOPS_FILE" ] || die "$SOPS_FILE not found"

if grep -q '^sops_version=' "$SOPS_FILE"; then
  ok "$SOPS_FILE is a SOPS dotenv file"
else
  bad "$SOPS_FILE carries no SOPS metadata"
fi

desired="$(desired_recipients)"
actual="$(actual_recipients)"

added="$(comm -13 <(printf '%s\n' "$actual") <(printf '%s\n' "$desired"))"
removed="$(comm -23 <(printf '%s\n' "$actual") <(printf '%s\n' "$desired"))"

if [ -z "$added" ] && [ -z "$removed" ]; then
  ok "configured recipients match file recipients ($(printf '%s\n' "$actual" | grep -c .))"
else
  [ -n "$added" ]   && bad "in $SOPS_CONFIG but not authorized on the file:$(printf '\n%s' "$(printf '%s\n' "$added" | sed 's/^/      + /')")"
  [ -n "$removed" ] && bad "still able to decrypt but not in $SOPS_CONFIG:$(printf '\n%s' "$(printf '%s\n' "$removed" | sed 's/^/      - /')")"
fi

# Every value carrying a sops:encrypt marker must actually be encrypted. An
# empty value is exempt: SOPS leaves it empty because there is nothing to
# encrypt, and the marker still governs whatever value lands there later.
leaked="$(awk '
  /^[[:space:]]*#.*sops:encrypt/ { pending = 1; next }
  /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=/ {
    i = index($0, "="); val = substr($0, i + 1)
    if (pending && val != "" && val !~ /^ENC\[/) print substr($0, 1, i - 1)
    pending = 0
  }
' "$SOPS_FILE")"

empty_marked="$(awk '
  /^[[:space:]]*#.*sops:encrypt/ { pending = 1; next }
  /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=/ {
    i = index($0, "="); val = substr($0, i + 1)
    if (pending && val == "") print substr($0, 1, i - 1)
    pending = 0
  }
' "$SOPS_FILE")"

if [ -z "$leaked" ]; then
  ok "every sops:encrypt marked value is encrypted"
else
  bad "marked but left in plaintext:$(printf '\n%s' "$(printf '%s\n' "$leaked" | sed 's/^/      /')")"
fi

if [ -n "$empty_marked" ]; then
  note "note" "marked but currently empty (nothing to encrypt yet):"
  printf '%s\n' "$empty_marked" | sed 's/^/      /'
fi

# Advisory naming lint. Catches a sensitive-looking variable that nobody
# remembered to mark. It is a hint, not the source of truth -- DATABASE_URL
# style values carry credentials without a sensitive-looking name.
suspect="$(awk '
  /^sops_/ { next }
  /^[A-Za-z_][A-Za-z0-9_]*=/ {
    i = index($0, "="); name = substr($0, 1, i - 1); val = substr($0, i + 1)
    if (val == "" || val ~ /^ENC\[/) next
    if (name ~ /(_SECRET|_PASSWORD|_TOKEN|_API_KEY|_PRIVATE_KEY)$/) print name
  }
' "$SOPS_FILE")"

if [ -n "$suspect" ]; then
  note "WARN" "sensitive-looking but not encrypted (confirm this is intended):"
  printf '%s\n' "$suspect" | sed 's/^/      /'
fi

# The plaintext copy must never be committed.
if git rev-parse --git-dir >/dev/null 2>&1; then
  if git ls-files --error-unmatch "$ENV_FILE" >/dev/null 2>&1; then
    bad "$ENV_FILE is tracked by git"
  else
    ok "$ENV_FILE is not tracked by git"
  fi
fi

exit "$fail"
